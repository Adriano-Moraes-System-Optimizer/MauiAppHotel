<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.MainPage"
             Title="App Hotel">

    <!-- Definindo uma cor de fundo personalizada -->
    <ContentPage.BackgroundColor>
        <Color>#F4F4F9</Color>
    </ContentPage.BackgroundColor>

    <VerticalStackLayout Spacing="15" Padding="20">

        <Label Text="Cálculo da Diária" 
               FontSize="26" 
               FontAttributes="Bold" 
               HorizontalOptions="Center" 
               TextColor="DarkBlue"/>

        <Label Text="Selecione sua Acomodação:" FontAttributes="Bold" TextColor="Black"/>
        <!-- Este é o pck_quarto que estava dando erro -->
        <Picker x:Name="pck_quarto" 
                Title="Escolha sua Suíte"
                ItemDisplayBinding="{Binding Descricao}" 
                BackgroundColor="White" />

        <!-- Campos de Adultos e Crianças usando Grid para alinhar -->
        <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto" ColumnSpacing="10">
            <Label Text="Adultos:" Grid.Row="0" Grid.Column="0" VerticalOptions="Center" TextColor="Black"/>
            <Label x:Name="lbl_adultos" Text="{Binding Source={x:Reference stp_adultos}, Path=Value}" Grid.Row="0" Grid.Column="1" VerticalOptions="Center" TextColor="Black"/>
            <!-- Este é o stp_adultos que estava dando erro -->
            <Stepper x:Name="stp_adultos" Minimum="1" Maximum="10" Increment="1" Value="1" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"/>
        </Grid>

        <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto" ColumnSpacing="10">
            <Label Text="Crianças:" Grid.Row="0" Grid.Column="0" VerticalOptions="Center" TextColor="Black"/>
            <Label x:Name="lbl_criancas" Text="{Binding Source={x:Reference stp_criancas}, Path=Value}" Grid.Row="0" Grid.Column="1" VerticalOptions="Center" TextColor="Black"/>
            <!-- Este é o stp_criancas que estava dando erro -->
            <Stepper x:Name="stp_criancas" Minimum="0" Maximum="10" Increment="1" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"/>
        </Grid>

        <!-- Bloco de Datas -->
        <Frame CornerRadius="10" BackgroundColor="White" Padding="15" HasShadow="True">
            <VerticalStackLayout Spacing="10">
                <Label Text="Período da Estadia:" FontAttributes="Bold" TextColor="Black"/>

                <Label Text="Check-in:" TextColor="Black"/>
                <!-- Este é o dtpck_checkin que estava dando erro -->
                <DatePicker x:Name="dtpck_checkin" Format="dd/MM/yyyy" />

                <Label Text="Check-out:" TextColor="Black"/>
                <!-- Este é o dtpck_checkout que estava dando erro -->
                <DatePicker x:Name="dtpck_checkout" Format="dd/MM/yyyy" />
            </VerticalStackLayout>
        </Frame>

        <!-- O evento 'Button_Clicked' liga o botão ao código do MainPage.xaml.cs -->
        <Button Text="Avançar" Clicked="Button_Clicked" BackgroundColor="SlateBlue" TextColor="White" CornerRadius="15" Margin="0,15,0,0" />

    </VerticalStackLayout>
</ContentPage>